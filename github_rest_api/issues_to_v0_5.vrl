# Convert GitHub REST API /repos/{owner}/{repo}/issues response to CDEvents
#
# Input: paginated response from GET /repos/{owner}/{repo}/issues?state=all
#   .body = [{...}, ...]  (bare array)
#
# Note: GitHub issues API returns both issues AND pull requests.
#       Items with a "pull_request" field are skipped here (handled by pull_requests_to_v0_5.vrl).
#
# | done | GitHub REST field   | CDEvent(s) emitted        |
# | ---- | ------------------- | ------------------------- |
# | [x]  | any issue           | ticket:created            |
# | [x]  | state == closed     | ticket:created + closed   |
#
# Rules:
# - context.id is computed by the collector (content-based CID)
# - subject.id = issue.url (API URL)
# - Each phase uses its own timestamp for idempotent backfill (see RULES.md)
# - ticket:created is emitted for EVERY issue, including already closed ones: a REST backfill would
#   otherwise only ever produce the terminal event, and the lifecycle start needed to compute issue
#   age / time to resolution in cdevents space would be missing forever.
# - customData for the created phase only includes fields stable at that point (no state,
#   state_reason, closed_at), so re-polling the same issue later does not change its CID

items = array(.body) ?? []
events = map_values(items) -> |issue| {
  if exists(issue.pull_request) {
    []
  } else {
    repo_url = to_string(issue.repository_url) ?? ""
    links = [{
      "linkKind": "storedAt",
      "target": { "subject": { "type": "repository", "id": repo_url } },
    }]

    # created — emitted whatever the current state
    created_ts = format_timestamp!(parse_timestamp(issue.created_at, "%+") ?? now(), format: "%+")
    created_event = {
      "context": {
        "specversion": "0.5.0",
        "type": "dev.cdevents.ticket.created.0.2.0",
        "timestamp": created_ts,
      },
      "subject": {
        "id": to_string!(issue.url),
        "content": {
          "summary": to_string(issue.title) ?? "",
          "creator": to_string(issue.user.login) ?? "",
          "assignees": map_values(array!(issue.assignees || [])) -> |a| { a.login },
          "labels": map_values(array!(issue.labels || [])) -> |l| { l.name },
          "milestone": issue.milestone.title,
          "uri": to_string!(issue.html_url),
        },
      },
      "customData": {
        "links": links,
        "github": {
          "issue": {
            "number": issue.number,
            "title": issue.title,
            "url": issue.url,
            "created_at": issue.created_at,
          },
        },
      },
    }

    # closed — only once the issue is closed
    closed_events = if issue.state == "closed" {
      closed_ts = format_timestamp!(parse_timestamp(issue.closed_at, "%+") ?? now(), format: "%+")
      [{
        "context": {
          "specversion": "0.5.0",
          "type": "dev.cdevents.ticket.closed.0.2.0",
          "timestamp": closed_ts,
        },
        "subject": {
          "id": to_string!(issue.url),
          "content": {
            "summary": to_string(issue.title) ?? "",
            "creator": to_string(issue.user.login) ?? "",
            "resolution": to_string(issue.state_reason) ?? "",
            "uri": to_string!(issue.html_url),
          },
        },
        "customData": {
          "links": links,
          "github": {
            "issue": {
              "number": issue.number,
              "state": issue.state,
              "state_reason": issue.state_reason,
              "title": issue.title,
              "url": issue.url,
              "closed_at": issue.closed_at,
            },
          },
        },
      }]
    } else {
      []
    }

    flatten([[created_event], closed_events])
  }
}
bodies = flatten(events)
bodies = filter(bodies) -> |_index, body| { !is_null(body) }

map_values(bodies) -> |body| {
  { "metadata": .metadata, "headers": .headers, "body": body }
}
