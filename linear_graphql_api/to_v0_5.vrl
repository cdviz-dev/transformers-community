# Convert a Linear GraphQL API `issues` page to CDEvents.
# Use with an `http_polling` source, for backfill or in place of the webhook.
# https://linear.app/developers/graphql
#
# Input: one page of the `issues` query (see cdviz-collector.toml for the query)
#   .body = { "data": { "issues": { "nodes": [...], "pageInfo": {...} } } }
#   .metadata.ts_after / .metadata.ts_before = the poll time window (set by `http_polling`)
#
# | done | condition                                                  | cdevent        | timestamp                |
# | ---- | ---------------------------------------------------------- | -------------- | ------------------------ |
# | [x]  | createdAt in window                                        | ticket:created | createdAt                |
# | [x]  | completedAt or canceledAt in window                        | ticket:closed  | completedAt / canceledAt |
# | [x]  | updatedAt in window, not equal to the created or closed time | ticket:updated | updatedAt              |
#
# Rules:
# - context.id is computed by the collector (content-based CID)
# - subject.id is the same as in `linear_webhook` (issue url without the title slug),
#   so events from the webhook and from polling are about the same subject
# - each event uses its own timestamp, never now()
# - an event is emitted only when its timestamp is in the poll window, so each lifecycle step
#   is emitted once, even when the issue is polled again after later edits.
#   Polling is an approximation of the history: edits between two polls give one
#   ticket:updated with the last state, and content is the state at poll time.
# - without window metadata (e.g. `cdviz-collector transform`), every event is emitted
# - window bounds and timestamps are compared in milliseconds, like the driver query

# Window in unix milliseconds. `ts_after` defaults to the beginning of time (negative year):
# it does not parse, so the window has no lower bound.
after_ms = 0
ts = parse_timestamp(string(.metadata.ts_after) ?? "", "%+") ?? null
if is_timestamp(ts) { after_ms = to_unix_timestamp(timestamp!(ts), unit: "milliseconds") }
before_ms = 9999999999999
ts = parse_timestamp(string(.metadata.ts_before) ?? "", "%+") ?? null
if is_timestamp(ts) { before_ms = to_unix_timestamp(timestamp!(ts), unit: "milliseconds") }

nodes = array(.body.data.issues.nodes) ?? []

events = map_values(nodes) -> |issue| {
  uri = replace(to_string!(issue.url), r'^(https://[^/]+/[^/]+/issue/[^/]+).*$', "$1")
  creator = if !is_nullish(issue.creator) { issue.creator.id } else { null }
  assignees = if !is_nullish(issue.assignee) { [to_string!(issue.assignee.id)] } else { [] }
  labels = map_values(array(issue.labels.nodes) ?? []) -> |label| { to_string!(label.name) }
  milestone = if !is_nullish(issue.projectMilestone) { issue.projectMilestone.name } else { null }

  content = {
    "summary": issue.title,
    "ticketType": "issue",
    "uri": uri,
    "priority": downcase(to_string(issue.priorityLabel) ?? "no priority"),
    "creator": creator,
    "assignees": assignees,
    "labels": labels,
    "milestone": milestone,
  }

  custom_data = {
    "linear": {
      "issue": {
        "id": issue.id,
        "identifier": issue.identifier,
        "number": issue.number,
        "url": issue.url,
        "state": issue.state,
        "team": issue.team,
        "project": issue.project,
        "cycle": issue.cycle,
      },
    },
  }

  created_ts = parse_timestamp!(issue.createdAt, "%+")
  created_ms = to_unix_timestamp(created_ts, unit: "milliseconds")
  updated_ts = parse_timestamp!(issue.updatedAt, "%+")
  updated_ms = to_unix_timestamp(updated_ts, unit: "milliseconds")
  closed_at = if !is_nullish(issue.completedAt) { issue.completedAt } else { issue.canceledAt }
  closed_ms = -1
  closed_ts = null
  if !is_nullish(closed_at) {
    closed_ts = parse_timestamp!(closed_at, "%+")
    closed_ms = to_unix_timestamp(closed_ts, unit: "milliseconds")
  }

  out = []

  if created_ms >= after_ms && created_ms < before_ms {
    out = push(out, {
      "context": {
        "specversion": "0.5.0",
        "source": .metadata.context.source,
        "type": "dev.cdevents.ticket.created.0.2.0",
        "timestamp": format_timestamp!(created_ts, format: "%+"),
      },
      "subject": { "id": uri, "content": content },
      "customData": custom_data,
    })
  }

  if closed_ms >= after_ms && closed_ms < before_ms {
    closed_content = content
    closed_content.resolution = if !is_nullish(issue.completedAt) {
      "completed"
    } else if downcase(to_string(issue.state.name) ?? "") == "duplicate" {
      "duplicate"
    } else {
      "withdrawn"
    }
    out = push(out, {
      "context": {
        "specversion": "0.5.0",
        "source": .metadata.context.source,
        "type": "dev.cdevents.ticket.closed.0.2.0",
        "timestamp": format_timestamp!(timestamp!(closed_ts), format: "%+"),
      },
      "subject": { "id": uri, "content": closed_content },
      "customData": custom_data,
    })
  }

  if updated_ms >= after_ms && updated_ms < before_ms && updated_ms != created_ms && updated_ms != closed_ms {
    out = push(out, {
      "context": {
        "specversion": "0.5.0",
        "source": .metadata.context.source,
        "type": "dev.cdevents.ticket.updated.0.2.0",
        "timestamp": format_timestamp!(updated_ts, format: "%+"),
      },
      "subject": { "id": uri, "content": content },
      "customData": custom_data,
    })
  }

  out
}

map_values(flatten(events)) -> |body| {
  { "metadata": .metadata, "headers": .headers, "body": body }
}
